---
import type { Article } from "../lib/mongodb";
import StoryCard from "./StoryCard.astro";
import { formatTag } from "../lib/tags";

interface Props {
  tag: string;
  articles: Article[];
}

const { tag, articles } = Astro.props;
const items = articles.slice(0, 6);
---

<section class="topic">
  <div class="topic-head">
    <h2>{formatTag(tag)}</h2>
    <a class="see-more" href={`/tag/${tag}`}>See More →</a>
  </div>
  <div class="rows">
    {items.map((article) => (
      <StoryCard article={article} variant="compact" />
    ))}
  </div>
</section>

<style>
  .topic {
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
  }

  .topic-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .topic-head h2 {
    font-size: 1.5rem;
    margin: 0;
  }

  .see-more {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.78rem;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
  }

  .see-more:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .rows {
    display: grid;
  }

  .rows :global(.story-compact:last-child) {
    border-bottom: none;
  }
</style>
