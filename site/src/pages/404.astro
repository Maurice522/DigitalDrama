---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page Not Found — DigitalDrama"
  description="This page doesn't exist or may have moved."
>
  <section class="error-page">
    <span class="code">404</span>
    <h1>This page went missing.</h1>
    <p>
      Whatever you were looking for isn't here — it may have been moved,
      renamed, or never existed in the first place. Even internet drama fades
      eventually.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Back to Home</a>
      <a class="btn" href="/blog">Browse the Archive</a>
    </div>
  </section>
</Layout>

<style>
  .error-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 44ch;
    margin: 0 auto;
    padding: var(--sp-64) var(--sp-16);
  }

  .code {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
    background: var(--mono-bg);
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: var(--sp-16);
  }

  .error-page h1 {
    font-size: 2.2rem;
    margin: 0 0 0.6rem;
  }

  .error-page p {
    font-size: 0.95rem;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    margin-top: var(--sp-16);
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.65rem 1.2rem;
    border-radius: 4px;
    border: 1px solid var(--line);
    color: var(--ink);
    background: var(--paper-raised);
  }

  .btn:hover {
    border-color: var(--ink-faint);
  }

  .btn-primary {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .btn-primary:hover {
    opacity: 0.85;
  }
</style>
