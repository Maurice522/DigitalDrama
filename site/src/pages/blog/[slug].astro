---
import Layout from "../../layouts/Layout.astro";
import StoryCard from "../../components/StoryCard.astro";
import { getArticles } from "../../lib/mongodb";
import { toParagraphs, renderInlineMarkdown, excerpt } from "../../lib/text";
import { formatRelative, formatAbsolute } from "../../lib/time";
import { hueIndexForTag, primaryTag, formatTag } from "../../lib/tags";

export async function getStaticPaths() {
  const articles = await getArticles();
  return Promise.all(
    articles.map(async (article) => {
      const tagSet = new Set(article.tags ?? []);
      const related = articles
        .filter((a) => a.slug !== article.slug && (a.tags ?? []).some((t) => tagSet.has(t)))
        .slice(0, 4);
      const fallback = related.length >= 3
        ? related
        : [...related, ...articles.filter((a) => a.slug !== article.slug && !related.includes(a))].slice(0, 4);
      return {
        params: { slug: article.slug },
        props: { article, related: fallback },
      };
    }),
  );
}

const { article, related } = Astro.props;
const tag = primaryTag(article);
const hue = tag ? hueIndexForTag(tag) : 0;
const shareText = encodeURIComponent(article.title);
const shareUrl = encodeURIComponent(`https://example.com/blog/${article.slug}`);

const showPixelAsHero = !article.image && Boolean(article.pixelArt);
const showPixelSticker = Boolean(article.image) && Boolean(article.pixelArt);
const heroVisual = article.image ?? (showPixelAsHero ? article.pixelArt : null);

// Article-specific keywords lead with the site's tags for this story, with
// the shared brand/supporting terms folded in after so the page still
// carries the site-wide SEO baseline.
const articleKeywords = [
  "DigitalDrama",
  ...(article.tags ?? []),
  "internet drama",
  "gaming drama",
  "tech scandal",
];
---

<Layout
  title={`${article.title} — DigitalDrama`}
  description={excerpt(article.summary, 160)}
  keywords={articleKeywords}
  type="article"
>
  <article class="post" style={`--hue: var(--h${hue})`}>
    <div class={`art-hero ${heroVisual ? "" : "no-image"}`}>
      {heroVisual && (
        <div class="hero-image">
          <img src={heroVisual} alt="" class={showPixelAsHero ? "pixel-hero" : ""} />
          {showPixelSticker && (
            <img class="pixel-sticker" src={article.pixelArt} alt="Pixel art rendition of this story" />
          )}
        </div>
      )}
      <div class="hero-panel">
        <div class="panel-top">
          {tag && <a class="eyebrow" href={`/tag/${tag}`}>{formatTag(tag)}</a>}
          <div class="share-row" data-share>
            <button type="button" class="share-btn" data-copy data-url={`https://example.com/blog/${article.slug}`} aria-label="Copy link">
              <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 12a3 3 0 0 0 4.24.24l2-2a3 3 0 0 0-4.24-4.24l-1 1"/><path d="M12 8a3 3 0 0 0-4.24-.24l-2 2a3 3 0 0 0 4.24 4.24l1-1"/></svg>
            </button>
            <a class="share-btn" href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X">
              <svg viewBox="0 0 20 20" width="15" height="15" fill="currentColor"><path d="M11.9 8.6 18 2h-2l-5.2 5.7L6.7 2H1l6.4 9.2L1 18h2l5.6-6.1L13.3 18H19l-7.1-9.4Z"/></svg>
            </a>
            <a class="share-btn" href={`https://reddit.com/submit?url=${shareUrl}&title=${shareText}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Reddit">
              <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><circle cx="10" cy="11" r="7"/></svg>
            </a>
            <span class="toast" data-toast hidden>Link copied</span>
          </div>
        </div>
        <div class="panel-bottom">
          <h1>{article.title}</h1>
          <div class="meta">
            <span>{article.sourceName}</span>
            <span class="dot">·</span>
            <time datetime={article.publishedAt} title={formatAbsolute(article.publishedAt)}>
              {formatRelative(article.publishedAt)}
            </time>
          </div>
        </div>
      </div>
    </div>

    <div class="reading-col">
      <div class="tags-row">
        {article.tags?.length > 0 && (
          <ul class="tags">
            {article.tags.map((t) => (
              <li><a href={`/tag/${t}`}>{formatTag(t)}</a></li>
            ))}
          </ul>
        )}
        <div class="tts-controls">
          <button type="button" class="tts-restart-btn" data-tts-restart="all" aria-label="Restart" hidden>↺</button>
          <button type="button" class="tts-btn" data-tts="all" aria-label="Read the article and our take aloud">
            <span data-tts-icon>▶</span><span data-tts-label>Listen</span>
          </button>
        </div>
      </div>

      <section class="summary">
        {toParagraphs(article.summary).map((paragraph) => (
          <p set:html={renderInlineMarkdown(paragraph)} />
        ))}
      </section>

      <section class="opinion">
        <div class="opinion-head">
          <div class="opinion-head-left">
            {article.pixelArt && (
              <button type="button" class="pixel-icon-btn" data-pixel-sound aria-label="Play a sound">
                <img class="pixel-icon" src={article.pixelArt} alt="" />
              </button>
            )}
            <div class="opinion-head-text">
              <h2>Our take</h2>
              <p class="opinion-note">Live commentary on a developing story, not a final verdict.</p>
            </div>
          </div>
          <div class="tts-controls">
            <button type="button" class="tts-restart-btn" data-tts-restart="opinion" aria-label="Restart" hidden>↺</button>
            <button type="button" class="tts-btn" data-tts="opinion" aria-label="Read our take aloud">
              <span data-tts-icon>▶</span><span data-tts-label>Listen</span>
            </button>
          </div>
        </div>
        {toParagraphs(article.opinion).map((paragraph) => (
          <p set:html={renderInlineMarkdown(paragraph)} />
        ))}
      </section>

      <script
        type="application/json"
        id="tts-data"
        set:html={JSON.stringify({
          slug: article.slug,
          apiUrl: import.meta.env.PUBLIC_TTS_API_URL ?? "/api/tts",
        })}
      />

      <p class="source-line">
        This is our take on a developing story, not the final word — read the original reporting at{" "}
        <a href={article.sourceUrl} target="_blank" rel="noopener noreferrer">{article.sourceName} ↗</a>
      </p>

      {related.length > 0 && (
        <section class="related">
          <h2>Related stories</h2>
          <div class="related-grid">
            {related.map((r) => (
              <StoryCard article={r} variant="standard" />
            ))}
          </div>
        </section>
      )}

      <section class="newsletter-band">
        <div>
          <h3>Get the drama in your inbox</h3>
          <p>Hourly rewrites of the internet's messiest stories, no fluff.</p>
        </div>
        <form onsubmit="return false">
          <input type="email" placeholder="you@example.com" aria-label="Email address" disabled />
          <button type="button" disabled>Subscribe</button>
        </form>
      </section>

      <p class="back"><a href="/blog">← Back to archive</a></p>
    </div>
  </article>
</Layout>

<script is:inline>
  document.querySelectorAll("[data-copy]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var url = btn.getAttribute("data-url");
      var row = btn.closest("[data-share]");
      var toast = row ? row.querySelector("[data-toast]") : null;
      navigator.clipboard?.writeText(url).then(function () {
        if (!toast) return;
        toast.hidden = false;
        setTimeout(function () {
          toast.hidden = true;
        }, 1600);
      });
    });
  });

  function getAudioCtx() {
    var Ctx = window.AudioContext || window.webkitAudioContext;
    if (!Ctx) return null;
    if (!window.__spaceCtx) window.__spaceCtx = new Ctx();
    if (window.__spaceCtx.state === "suspended") window.__spaceCtx.resume();
    return window.__spaceCtx;
  }

  function echoBus(ctx, mix) {
    var delay = ctx.createDelay();
    delay.delayTime.value = 0.16;
    var feedback = ctx.createGain();
    feedback.gain.value = 0.4;
    var wet = ctx.createGain();
    wet.gain.value = mix;
    delay.connect(feedback);
    feedback.connect(delay);
    delay.connect(wet);
    wet.connect(ctx.destination);
    return delay;
  }

  function isSpeaking() {
    return !!window.__ttsActive;
  }

  function playLaser() {
    try {
      if (isSpeaking()) return;
      var ctx = getAudioCtx();
      if (!ctx) return;
      var now = ctx.currentTime;
      var osc = ctx.createOscillator();
      var filter = ctx.createBiquadFilter();
      var gain = ctx.createGain();
      osc.type = "sawtooth";
      osc.frequency.setValueAtTime(1600, now);
      osc.frequency.exponentialRampToValueAtTime(90, now + 0.28);
      filter.type = "lowpass";
      filter.frequency.setValueAtTime(1800, now);
      filter.frequency.exponentialRampToValueAtTime(400, now + 0.3);
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(0.07, now + 0.04);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.32);
      var delay = echoBus(ctx, 0.3);
      osc.connect(filter);
      filter.connect(gain);
      gain.connect(ctx.destination);
      gain.connect(delay);
      osc.start(now);
      osc.stop(now + 0.9);
    } catch (err) {
      // ignore audio failures (autoplay policy, unsupported browser, etc.)
    }
  }

  function playUfo() {
    try {
      if (isSpeaking()) return;
      var ctx = getAudioCtx();
      if (!ctx) return;
      var now = ctx.currentTime;
      var osc = ctx.createOscillator();
      var gain = ctx.createGain();
      var lfo = ctx.createOscillator();
      var lfoGain = ctx.createGain();
      var trem = ctx.createOscillator();
      var tremGain = ctx.createGain();

      osc.type = "sine";
      osc.frequency.setValueAtTime(320, now);
      lfo.frequency.setValueAtTime(5, now);
      lfoGain.gain.setValueAtTime(60, now);
      lfo.connect(lfoGain);
      lfoGain.connect(osc.frequency);
      trem.frequency.setValueAtTime(9, now);
      tremGain.gain.setValueAtTime(0.025, now);
      trem.connect(tremGain);

      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(0.07, now + 0.08);
      tremGain.connect(gain.gain);
      gain.gain.setValueAtTime(0.07, now + 0.7);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.9);

      osc.connect(gain).connect(ctx.destination);
      osc.start(now);
      lfo.start(now);
      trem.start(now);
      osc.stop(now + 0.9);
      lfo.stop(now + 0.9);
      trem.stop(now + 0.9);
    } catch (err) {
      // ignore audio failures (autoplay policy, unsupported browser, etc.)
    }
  }

  function playRocket() {
    try {
      if (isSpeaking()) return;
      var ctx = getAudioCtx();
      if (!ctx) return;
      var now = ctx.currentTime;
      var bufSize = ctx.sampleRate * 0.9;
      var buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);
      var data = buf.getChannelData(0);
      for (var i = 0; i < bufSize; i++) data[i] = Math.random() * 2 - 1;

      var noise = ctx.createBufferSource();
      noise.buffer = buf;
      var filter = ctx.createBiquadFilter();
      filter.type = "bandpass";
      filter.Q.value = 1.4;
      filter.frequency.setValueAtTime(180, now);
      filter.frequency.exponentialRampToValueAtTime(2200, now + 0.9);
      var gain = ctx.createGain();
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(0.06, now + 0.5);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.9);

      noise.connect(filter).connect(gain).connect(ctx.destination);
      noise.start(now);
      noise.stop(now + 0.9);
    } catch (err) {
      // ignore audio failures (autoplay policy, unsupported browser, etc.)
    }
  }

  var pixelIcon = document.querySelector(".pixel-icon");
  var pixelIconBtn = document.querySelector("[data-pixel-sound]");
  var opinionSection = document.querySelector(".opinion");

  if (pixelIconBtn) {
    pixelIconBtn.addEventListener("click", function () {
      if (Math.random() < 0.5) playLaser();
      else playUfo();
    });
  }

  if (pixelIcon && opinionSection && "IntersectionObserver" in window) {
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          pixelIcon.classList.toggle("jump", entry.isIntersecting);
          if (entry.isIntersecting) playRocket();
        });
      },
      { threshold: 0.5 },
    );
    observer.observe(opinionSection);
  }

  (function () {
    var dataEl = document.getElementById("tts-data");
    var ttsData = { slug: "", apiUrl: "/api/tts" };
    try {
      ttsData = JSON.parse(dataEl ? dataEl.textContent : "{}");
    } catch (err) {
      ttsData = { slug: "", apiUrl: "/api/tts" };
    }

    // One entry per section (not per paragraph) — the backend checks its own
    // MongoDB cache first and only generates fresh audio on a genuine miss,
    // so every request here is cheap after the first listener for a section.
    function buildQueue(mode) {
      var sections = mode === "all" ? ["summary", "opinion"] : ["opinion"];
      return sections.map(function (section) {
        return { section: section };
      });
    }

    var ttsButtons = document.querySelectorAll(".tts-btn");
    var restartButtons = document.querySelectorAll("[data-tts-restart]");
    var activeBtn = null;
    var ttsState = "idle"; // "idle" | "loading" | "playing" | "paused"
    var audioEl = new Audio();
    var currentObjectUrl = null;

    function restartButtonFor(btn) {
      return document.querySelector('[data-tts-restart="' + btn.getAttribute("data-tts") + '"]');
    }

    function setButtonState(btn, state) {
      btn.classList.toggle("is-playing", state === "playing");
      btn.classList.toggle("is-paused", state === "paused");
      var icon = btn.querySelector("[data-tts-icon]");
      var label = btn.querySelector("[data-tts-label]");
      if (state === "loading") {
        if (icon) icon.textContent = "…";
        if (label) label.textContent = "Loading";
      } else if (state === "playing") {
        if (icon) icon.textContent = "⏸";
        if (label) label.textContent = "Pause";
      } else if (state === "paused") {
        if (icon) icon.textContent = "▶";
        if (label) label.textContent = "Resume";
      } else {
        if (icon) icon.textContent = "▶";
        if (label) label.textContent = "Listen";
      }
      // Only ever hide restart here — showing it is driven exclusively by
      // the audio element's native "playing" event below, so it doesn't
      // appear until sound has actually started (not just when .play() was
      // called, since there's a real buffering/decoding gap before then).
      var restartBtn = restartButtonFor(btn);
      if (restartBtn && (state === "idle" || state === "loading")) {
        restartBtn.hidden = true;
      }
    }

    function setState(state) {
      ttsState = state;
      if (activeBtn) setButtonState(activeBtn, state);
      window.__ttsActive = state === "playing";
    }

    function stopAll() {
      audioEl.pause();
      audioEl.removeAttribute("src");
      if (currentObjectUrl) {
        URL.revokeObjectURL(currentObjectUrl);
        currentObjectUrl = null;
      }
      window.__ttsActive = false;
      ttsButtons.forEach(function (btn) {
        setButtonState(btn, "idle");
      });
      activeBtn = null;
      ttsState = "idle";
    }

    function pauseCurrent() {
      audioEl.pause();
      setState("paused");
    }

    function resumeCurrent() {
      audioEl.play();
      setState("playing");
    }

    function playSrc(btn, src, revoke) {
      if (activeBtn !== btn) return;
      if (currentObjectUrl) URL.revokeObjectURL(currentObjectUrl);
      currentObjectUrl = revoke ? src : null;
      audioEl.src = src;
      setState("playing");
      audioEl.play();
    }

    function playQueue(btn, queue, index) {
      if (activeBtn !== btn) return;
      if (index >= queue.length) {
        stopAll();
        return;
      }
      var item = queue[index];
      setState("loading");
      var contentType = "audio/mpeg";
      fetch(ttsData.apiUrl, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ slug: ttsData.slug, section: item.section }),
      })
        .then(function (res) {
          if (!res.ok) throw new Error("tts request failed: " + res.status);
          contentType = res.headers.get("content-type") || contentType;
          return res.arrayBuffer();
        })
        .then(function (buf) {
          if (activeBtn !== btn) return;
          playSrc(btn, URL.createObjectURL(new Blob([buf], { type: contentType })), true);
        })
        .catch(function () {
          if (activeBtn === btn) stopAll();
        });
    }

    audioEl.addEventListener("ended", function () {
      if (!activeBtn) return;
      var btn = activeBtn;
      var queue = buildQueue(btn.getAttribute("data-tts"));
      var nextIndex = (btn.__ttsIndex || 0) + 1;
      btn.__ttsIndex = nextIndex;
      playQueue(btn, queue, nextIndex);
    });

    // Fires once audio is genuinely producing sound (including after a
    // buffering stall), as opposed to the moment .play() was merely called.
    audioEl.addEventListener("playing", function () {
      if (!activeBtn) return;
      var restartBtn = restartButtonFor(activeBtn);
      if (restartBtn) restartBtn.hidden = false;
    });

    ttsButtons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        if (activeBtn !== btn) {
          // Switching to a different button (or starting fresh) always
          // starts that button's queue from the beginning.
          stopAll();
          activeBtn = btn;
          btn.__ttsIndex = 0;
          var queue = buildQueue(btn.getAttribute("data-tts"));
          playQueue(btn, queue, 0);
          return;
        }

        // Same button clicked again: toggle pause/resume in place rather
        // than discarding playback position, except while still loading —
        // there's nothing to pause yet, so that just cancels.
        if (ttsState === "playing") {
          pauseCurrent();
        } else if (ttsState === "paused") {
          resumeCurrent();
        } else {
          stopAll();
        }
      });
    });

    restartButtons.forEach(function (restartBtn) {
      restartBtn.addEventListener("click", function () {
        var key = restartBtn.getAttribute("data-tts-restart");
        var btn = document.querySelector('.tts-btn[data-tts="' + key + '"]');
        if (!btn || activeBtn !== btn) return;
        // Reset all the way back to idle ("Listen") rather than jumping
        // straight back into playing — pausing then resuming from 0 would
        // leave the button reading "Pause" the whole time, giving no visual
        // sign anything happened. This makes the reset visible; clicking
        // Listen again starts fresh from the top.
        stopAll();
      });
    });
  })();
</script>

<style>
  .post {
    padding-top: var(--sp-32);
  }

  .art-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-24);
    margin-bottom: var(--sp-48);
  }

  .art-hero.no-image {
    grid-template-columns: 1fr;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-image {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-image .pixel-hero {
    object-fit: contain;
    background: var(--mono-bg);
    image-rendering: pixelated;
  }

  .hero-image img.pixel-sticker {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 84px;
    height: 84px;
    object-fit: cover;
    border: 3px solid var(--paper-raised);
    border-radius: 8px;
    box-shadow: var(--shadow-lg);
    transform: rotate(-4deg);
    image-rendering: pixelated;
  }

  .hero-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: color-mix(in srgb, var(--hue) 14%, var(--paper));
    border: 1px solid color-mix(in srgb, var(--hue) 35%, var(--line));
    border-radius: 6px;
    padding: var(--sp-24);
    min-height: 240px;
  }

  .panel-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .eyebrow {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hue);
    background: var(--paper-raised);
    padding: 3px 9px;
    border-radius: 3px;
    text-decoration: none;
  }

  .share-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    position: relative;
  }

  .share-btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    color: var(--ink-soft);
    cursor: pointer;
    text-decoration: none;
  }

  .share-btn:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }

  .toast {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.72rem;
    padding: 3px 9px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .panel-bottom h1 {
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.05;
    margin: 0 0 0.6rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .reading-col {
    max-width: 700px;
    margin: 0 auto;
  }

  .tags-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 var(--sp-24);
  }

  .tags {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .tags a {
    font-size: 0.76rem;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    background: var(--mono-bg);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    text-decoration: none;
    text-transform: capitalize;
  }

  .tags a:hover {
    color: var(--ink);
  }

  .summary p {
    font-size: 1.08rem;
    max-width: none;
  }

  .opinion {
    margin: var(--sp-32) 0;
    padding: var(--sp-24);
    background: var(--note-wash);
    border-left: 3px solid var(--note);
    border-radius: 0 6px 6px 0;
  }

  .opinion-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin: 0 0 0.7rem;
  }

  .opinion-head-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .opinion-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
