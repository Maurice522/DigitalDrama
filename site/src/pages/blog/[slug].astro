---
import Layout from "../../layouts/Layout.astro";
import StoryCard from "../../components/StoryCard.astro";
import { getArticles } from "../../lib/mongodb";
import { excerpt } from "../../lib/text";
import { formatRelative, formatAbsolute } from "../../lib/time";
import { hueIndexForTag, primaryTag, formatTag } from "../../lib/tags";

export async function getStaticPaths() {
  const articles = await getArticles();
  return Promise.all(
    articles.map(async (article) => {
      const tagSet = new Set(article.tags ?? []);
      const related = articles
        .filter((a) => a.slug !== article.slug && (a.tags ?? []).some((t) => tagSet.has(t)))
        .slice(0, 4);
      const fallback = related.length >= 3
        ? related
        : [...related, ...articles.filter((a) => a.slug !== article.slug && !related.includes(a))].slice(0, 4);
      return {
        params: { slug: article.slug },
        props: { article, related: fallback },
      };
    }),
  );
}

const { article, related } = Astro.props;
const tag = primaryTag(article);
const hue = tag ? hueIndexForTag(tag) : 0;
const canonicalArticleUrl = new URL(`/blog/${article.slug}`, Astro.site).toString();
const shareText = encodeURIComponent(article.title);
const shareUrl = encodeURIComponent(canonicalArticleUrl);

// Article-specific keywords lead with the site's tags for this story, with
// the shared brand/supporting terms folded in after so the page still
// carries the site-wide SEO baseline.
const articleKeywords = [
  "DigitalDramaa",
  ...(article.tags ?? []),
  "internet drama",
  "gaming drama",
  "tech scandal",
];
---

<Layout
  title={`${article.title} — DigitalDramaa`}
  description={excerpt(article.summary, 160)}
  keywords={articleKeywords}
  imageAlt={article.title}
  type="article"
  publishedTime={article.publishedAt}
  articleTags={article.tags}
  noindex
>
  <article class="post" style={`--hue: var(--h${hue})`}>
    {article.image && (
      <div class="ticker-hero">
        <img src={article.image} alt="" />
      </div>
    )}
    <div class="ticker-panel">
      <div class="panel-top">
        {tag && <a class="eyebrow" href={`/tag/${tag}`}>{formatTag(tag)}</a>}
        <div class="share-row" data-share>
          <button type="button" class="share-btn" data-copy data-url={canonicalArticleUrl} aria-label="Copy link">
            <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 12a3 3 0 0 0 4.24.24l2-2a3 3 0 0 0-4.24-4.24l-1 1"/><path d="M12 8a3 3 0 0 0-4.24-.24l-2 2a3 3 0 0 0 4.24 4.24l1-1"/></svg>
          </button>
          <a class="share-btn" href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X">
            <svg viewBox="0 0 20 20" width="15" height="15" fill="currentColor"><path d="M11.9 8.6 18 2h-2l-5.2 5.7L6.7 2H1l6.4 9.2L1 18h2l5.6-6.1L13.3 18H19l-7.1-9.4Z"/></svg>
          </a>
          <a class="share-btn" href={`https://reddit.com/submit?url=${shareUrl}&title=${shareText}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Reddit">
            <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><circle cx="10" cy="11" r="7"/></svg>
          </a>
          <span class="toast" data-toast hidden>Link copied</span>
        </div>
      </div>

      <div class="panel-body">
        {!article.image && article.pixelArt && (
          <img class="pixel-icon" src={article.pixelArt} alt="" />
        )}
        <div>
          <h1>{article.title}</h1>
          <div class="meta">
            <span>{article.sourceName}</span>
            <span class="dot">·</span>
            <time datetime={article.publishedAt} title={formatAbsolute(article.publishedAt)}>
              {formatRelative(article.publishedAt)}
            </time>
          </div>
        </div>
      </div>

      {article.tags?.length > 0 && (
        <ul class="tags">
          {article.tags.map((t) => (
            <li><a href={`/tag/${t}`}>{formatTag(t)}</a></li>
          ))}
        </ul>
      )}

      <a class="read-source" href={article.sourceUrl} target="_blank" rel="noopener noreferrer">
        Read the full story at {article.sourceName} ↗
      </a>
    </div>

    <div class="reading-col">
      <p class="ticker-note">
        This is a headline entry, tracked as it broke — not a rewritten article. For the
        full reporting, follow the link above to {article.sourceName}.
      </p>

      {related.length > 0 && (
        <section class="related">
          <h2>Related stories</h2>
          <div class="related-grid">
            {related.map((r) => (
              <StoryCard article={r} variant="standard" />
            ))}
          </div>
        </section>
      )}

      <p class="back"><a href="/blog">← Back to archive</a></p>
    </div>
  </article>
</Layout>

<script is:inline>
  document.querySelectorAll("[data-copy]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var url = btn.getAttribute("data-url");
      var row = btn.closest("[data-share]");
      var toast = row ? row.querySelector("[data-toast]") : null;
      navigator.clipboard?.writeText(url).then(function () {
        if (!toast) return;
        toast.hidden = false;
        setTimeout(function () {
          toast.hidden = true;
        }, 1600);
      });
    });
  });
</script>

<style>
  .post {
    padding-top: var(--sp-32);
  }

  .ticker-hero {
    max-width: 700px;
    margin: 0 auto var(--sp-16);
    border-radius: 6px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  .ticker-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ticker-panel {
    max-width: 700px;
    margin: 0 auto var(--sp-48);
    background: color-mix(in srgb, var(--hue) 14%, var(--paper));
    border: 1px solid color-mix(in srgb, var(--hue) 35%, var(--line));
    border-radius: 6px;
    padding: var(--sp-24);
  }

  .panel-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: var(--sp-16);
  }

  .eyebrow {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hue);
    background: var(--paper-raised);
    padding: 3px 9px;
    border-radius: 3px;
    text-decoration: none;
  }

  .share-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    position: relative;
  }

  .share-btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    color: var(--ink-soft);
    cursor: pointer;
    text-decoration: none;
  }

  .share-btn:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }

  .toast {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.72rem;
    padding: 3px 9px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .panel-body {
    display: flex;
    align-items: center;
    gap: var(--sp-16);
  }

  .pixel-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    image-rendering: pixelated;
    border-radius: 4px;
  }

  .panel-body h1 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    line-height: 1.1;
    margin: 0 0 0.5rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .tags {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    padding: 0;
    margin: var(--sp-16) 0 0;
    flex-wrap: wrap;
  }

  .tags a {
    font-size: 0.76rem;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    background: var(--paper-raised);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    text-decoration: none;
    text-transform: capitalize;
  }

  .tags a:hover {
    color: var(--ink);
  }

  .read-source {
    display: inline-block;
    margin-top: var(--sp-24);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--paper);
    background: var(--hue);
    border-radius: 4px;
    padding: 0.7rem 1.1rem;
    text-decoration: none;
  }

  .read-source:hover {
    opacity: 0.9;
  }

  .reading-col {
    max-width: 700px;
    margin: 0 auto;
  }

  .ticker-note {
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  .related {
    margin-top: var(--sp-32);
    padding-top: var(--sp-32);
    border-top: 1px solid var(--line);
  }

  .related h2 {
    font-size: 1.4rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-24);
    margin-top: var(--sp-16);
  }

  .back {
    margin-top: var(--sp-32);
  }

  .back a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
