MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
LLM_API_KEY=sk-ant-...

# Only used if PREGENERATE_AUDIO=true (off by default) — live TTS generation
# now happens in the separate digitaldrama-tts-backend project instead.
CARTESIA_API_KEY=sk_car_...
CARTESIA_API_KEY_2=sk_car_...
CARTESIA_API_KEY_3=sk_car_...
CARTESIA_BACKUP_API_KEY=sk_car_...

# Cloudflare Pages deploy hook — triggers a rebuild after new articles are added.
DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/xxxxxxxx

